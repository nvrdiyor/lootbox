# Bu faylni .env nomi bilan nusxalang. Birinchi ishga tushirishda .env yo'q bo'lsa,
# server uni o'zi yaratadi va admin parolini tasodifiy qilib qo'yadi.

# Admin panelga kirish paroli (/admin). Kamida 8 belgi, o'zingiz o'ylab toping.
# Bo'sh qoldirilsa admin panelga kirib bo'lmaydi.
ADMIN_PASSWORD=

# Server porti va manzili. Telefondan (bir xil Wi-Fi) ochish uchun HOST=0.0.0.0 qiling.
PORT=3210
HOST=127.0.0.1

# Saytning ochiq manzili (serverga qo'yilgandan keyin). Shu yozilgach sayt faqat shu domen
# nomi bilan ochiladi; Telegram / qidiruv uchun havolalarda ham shu ishlatiladi.
# SITE_URL=https://lootbox.uz

# Sayt nginx kabi proksi ortida tursa "true" qiling (HTTPS cookie va haqiqiy IP uchun).
# nginx shu sarlavhalarni uzatishi shart:
#   proxy_set_header Host $host;
#   proxy_set_header X-Real-IP $remote_addr;
#   proxy_set_header X-Forwarded-Proto $scheme;
# TRUST_PROXY=true

# Baza va rasmlar saqlanadigan papka (standart: ./data)
# DATA_DIR=./data
